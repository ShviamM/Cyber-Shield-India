<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    SMS scam protection: receive incoming texts to check them on the phone
    (SmsScreeningReceiver). Google Play allows this for "Anti-SMS phishing" and
    "spam detection" apps after a Permissions Declaration. Asked for only when
    the user turns SMS protection on.
  -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <application>
    <!--
      System-bound call screening service. Holding ROLE_CALL_SCREENING lets the
      OS hand each incoming call to onScreenCall() without any sensitive
      permission (no READ_CALL_LOG / READ_PHONE_STATE), so no Play "Permissions
      Declaration" is required. The service only warns; it never blocks calls.
    -->
    <service
      android:name="expo.modules.kavachscreening.KavachCallScreeningService"
      android:permission="android.permission.BIND_SCREENING_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.telecom.CallScreeningService" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.kavachscreening.SmsScreeningReceiver"
      android:permission="android.permission.BROADCAST_SMS"
      android:exported="true">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
