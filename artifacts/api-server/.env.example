# ── Netraksh API server — environment variables ─────────────────────────────
# Copy to ".env" (or set these in your host's dashboard) and fill in real values.

# Required ----------------------------------------------------------------------
NODE_ENV=production
# Port the server listens on (your host usually injects this automatically).
PORT=8080
# PostgreSQL connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/netraksh

# SMS / OTP login (MSG91) -------------------------------------------------------
# The app generates/verifies its own OTP; MSG91 only delivers the code via its
# Flow API to a DLT-approved template (variable name defaults to OTP).
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_flow_template_id
# Optional: approved Sender ID (often baked into the template).
MSG91_SENDER_ID=NETRKS
# Optional: template variable name that holds the code (defaults to OTP).
MSG91_OTP_VAR=OTP

# AI scam classifier (OpenAI) ---------------------------------------------------
# Optional: if unset, the fraud engine falls back to non-AI signals.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional override (defaults to https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional ----------------------------------------------------------------------
# Comma-separated admin phone numbers (Indian format) that may access /api/admin.
ADMIN_PHONES=
# Google Safe Browsing key for URL checks (falls back to heuristics if unset).
GOOGLE_SAFE_BROWSING_API_KEY=
# Logging
LOG_LEVEL=info

# OTP / rate-limit tuning (defaults shown) --------------------------------------
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_INTERVAL_SECONDS=30
# OTP_MAX_PER_HOUR=5
# OTP_REQUEST_MAX_PER_IP_PER_HOUR=10
# OTP_VERIFY_MAX_PER_IP_PER_MINUTE=10
# SESSION_TTL_DAYS=60
# REPORT_DUPLICATE_WINDOW_HOURS=24
# REPORT_MAX_PER_HOUR=20
# FRAUD_CHECK_MAX_PER_MINUTE=20
