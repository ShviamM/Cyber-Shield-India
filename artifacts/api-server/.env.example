# ── Netraksh API server — environment variables ─────────────────────────────
# Copy to ".env" (or set these in your host's dashboard) and fill in real values.

# Required ----------------------------------------------------------------------
NODE_ENV=production
# Port the server listens on (your host usually injects this automatically).
PORT=8080
# PostgreSQL connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/netraksh

# OTP login (MSG91 OTP Widget) --------------------------------------------------
# Login uses the MSG91 OTP Widget: the mobile app sends AND verifies the OTP
# directly with MSG91, then hands the resulting access-token to this server,
# which validates it via MSG91's verifyAccessToken API and issues our own
# session. Only these two server-side values are needed here:
#   MSG91_AUTH_KEY  — account auth key (SERVER-ONLY secret; never ship to client)
#   MSG91_WIDGET_ID — the widget id (must match the id the app initializes with)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WIDGET_ID=your_msg91_widget_id
# The mobile app also needs the PUBLIC widget credentials, set in the kavach-ai
# app's environment (NOT here): EXPO_PUBLIC_MSG91_WIDGET_ID and
# EXPO_PUBLIC_MSG91_TOKEN_AUTH.

# AI scam classifier (OpenAI) ---------------------------------------------------
# Optional: if unset, the fraud engine falls back to non-AI signals.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional override (defaults to https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional ----------------------------------------------------------------------
# Comma-separated admin phone numbers (Indian format) that may access /api/admin.
ADMIN_PHONES=
# Google Safe Browsing key for URL checks (falls back to heuristics if unset).
GOOGLE_SAFE_BROWSING_API_KEY=
# Logging
LOG_LEVEL=info

# Rate-limit tuning (defaults shown) --------------------------------------------
# OTP_REQUEST_MAX_PER_IP_PER_HOUR=30
# OTP_VERIFY_MAX_PER_IP_PER_MINUTE=10
# SESSION_TTL_DAYS=60
# REPORT_DUPLICATE_WINDOW_HOURS=24
# REPORT_MAX_PER_HOUR=20
# FRAUD_CHECK_MAX_PER_MINUTE=20
