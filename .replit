modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["twilio:1.0.0", "revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 19161
externalPort = 5173

[[ports]]
localPort = 23744
externalPort = 3002

[[ports]]
localPort = 25528
externalPort = 3000

[[ports]]
localPort = 25529
externalPort = 4200

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MSG91_WIDGET_ID = "3666646f3256373630343935"
EXPO_PUBLIC_MSG91_WIDGET_ID = "3666646f3256373630343935"
